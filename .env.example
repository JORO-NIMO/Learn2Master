# ── Learn2Master — Environment Variables Template ───────────────────────────
# Copy this file to .env and fill in your Supabase credentials.
# NEVER commit .env to version control.

# Supabase PostgreSQL connection string
# Found at: Supabase Dashboard → Project Settings → Database → URI (Transaction Pooler)
# Use port 6543 (transaction pooler) for Flask deployments
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Flask session signing key — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace_with_generated_hex_string

# Supabase project URL and keys
# Found at: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
