# Security
LEARN2MASTER_SECRET_KEY=generate-a-long-random-string
LEARN2MASTER_DEBUG=0
LEARN2MASTER_CSRF_ENABLED=1

# Database Configuration
# Supports local SQLite or external PostgreSQL/Supabase DB URL.
# For SQLite: sqlite:///learn2master.db
# For Supabase/PostgreSQL, use your transaction pooler or session connection string:
# e.g., postgresql://postgres.your-project-id:your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///learn2master.db

# AI API Keys
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here
TRAINING_API_URL=https://your-training-feedback-endpoint.com/log

# Supabase Auth and Vector Storage Integration
# Required for persistent vector storage, Knowledge Base file sync, and native user authentication.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
